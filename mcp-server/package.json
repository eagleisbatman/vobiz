{
  "name": "vobiz-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing Vobiz voice/telephony APIs as tools for AI agents",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vobiz-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/bundle.cjs",
    "start": "node dist/bundle.cjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "vobiz",
    "voice",
    "sip",
    "telephony",
    "ai-agent",
    "model-context-protocol"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.17"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
